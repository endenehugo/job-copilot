# 生产环境变量模板：复制到 /opt/job-copilot/.env 后填写
#   sudo cp deploy/.env.production.example /opt/job-copilot/.env
#   sudo vi /opt/job-copilot/.env
#   sudo chown root:jobcopilot /opt/job-copilot/.env && sudo chmod 640 /opt/job-copilot/.env
# 注意：backend/app/core/config.py 会同时读取仓库根与 backend/ 下的 .env，
# 而 systemd 通过 EnvironmentFile 注入同名变量，两者取值一致即可。

APP_ENV=prod

# 阿里云百炼（DashScope）：需开通 qwen-plus、qwen-vl-plus、text-embedding-v3
DASHSCOPE_API_KEY=sk-替换为真实Key

# 秘塔搜索（可选，web_search 工具用；留空则该工具不可用）
METASO_API_KEY=

# ---------------------------------------------------------------- MySQL
# 服务器上已有 MySQL 实例，库名与账号沿用现有值（当前为 llmrag），
# 这样才能直接看到已有的会话与历史数据。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=llmrag
MYSQL_PASSWORD=替换为现有密码
MYSQL_DATABASE=llmrag
MYSQL_CHARSET=utf8mb4

# 若新起一个干净的库，改成：
# MYSQL_USER=jobcopilot
# MYSQL_PASSWORD=新密码
# MYSQL_DATABASE=job_copilot

# 连接池（单 worker 默认即可）
# MYSQL_POOL_SIZE=5
# MYSQL_POOL_RECYCLE=3600

# 模型覆盖（可选）
# LLM_MODEL=qwen-plus
# MULTIMODAL_MODEL=qwen-vl-plus

# 日志级别（可选）
# LOG_LEVEL=INFO

# 资源目录（默认即 /opt/job-copilot/backend/resources，除非要做多实例共享，否则别设）
# RESOURCES_ROOT=/opt/job-copilot/backend/resources
