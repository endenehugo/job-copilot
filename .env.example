# 运行环境：dev / test / pre / prod
APP_ENV=dev

# DashScope（必填）：需开通 qwen-plus、qwen-vl-plus、text-embedding-v3
DASHSCOPE_API_KEY=sk-xxxx

# 秘塔搜索（可选）：web_search_tool 使用
METASO_API_KEY=mk-xxxx

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=job_copilot
MYSQL_CHARSET=utf8mb4

# 模型覆盖（可选）
# 「可更换的模型」清单见 backend/app/core/config.py :: SELECTABLE_LLM_MODELS
#   模型 ID                 输入/输出（元/百万 tokens）  端点
#   qwen3.8-max             12 / 36                     兼容模式（默认主模型）
#   qwen3.8-flash           0.8 / 2.7                   兼容模式（默认小模型）
#   qwen3.8-2.4t-a95b       12 / 36                     兼容模式
#   deepseek-v4.1-flash     1 / 4                       兼容模式（百炼托管）
#   kimi-k3                 20 / 100                    兼容模式（百炼托管，只接受 temperature=1）
#   qwen-plus               4.8 / 48                    原生 ChatTongyi
#   qwen-flash              1.2 / 12                    原生 ChatTongyi
# 换主模型：把 LLM_MODEL 改成清单里任意一个即可，无需改代码。
# LLM_MODEL=qwen3.8-max
# LLM_SMALL_MODEL=qwen3.8-flash
# 额度耗尽时的降级链（JSON 数组，便宜 → 贵；每个模型各有独立的免费额度）
# LLM_FALLBACK_MODELS=["qwen3.8-flash", "qwen-flash", "deepseek-v4.1-flash", "qwen-plus", "qwen3.8-2.4t-a95b", "kimi-k3"]
# MULTIMODAL_MODEL=qwen-vl-plus

# 端点分流与采样参数（一般不用改）
# 这一代新模型必须走 OpenAI 兼容模式，老模型走原生 ChatTongyi；工厂按模型自动选择。
# LLM_COMPATIBLE_MODE_MODELS=["qwen3.8-max", "qwen3.8-flash", "qwen3.8-2.4t-a95b", "deepseek-v4.1-flash", "kimi-k3"]
# LLM_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 第三方模型参数限制：kimi-k3 只接受 temperature=1 且不支持 top_p（JSON 对象）
# LLM_FIXED_TEMPERATURE_MODELS={"kimi-k3": 1}
# LLM_MODELS_WITHOUT_TOP_P=["kimi-k3"]
